# ── AI Providers ──────────────────────────────────────────────────────────────
# At least one of these two keys is required for AI features to work.
GEMINI_API_KEY=           # Required: Google Gemini API key
OPENROUTER_API_KEY=       # Optional: OpenRouter fallback key (enables GPT-4o etc.)

# ── Database ──────────────────────────────────────────────────────────────────
# Required. Use Supabase (recommended) or any PostgreSQL instance.
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000                 # Optional: defaults to 3000
NODE_ENV=development      # development | production

# ── Security ──────────────────────────────────────────────────────────────────
# Strongly recommended for production deployments.
# When set, every POST to /api/ai/* must include:
#   Authorization: Bearer <MIS_API_KEY>
# Generate a strong value with: openssl rand -hex 32
MIS_API_KEY=

# Required in production if the frontend is served from a different origin
# than the Express server (e.g. a CDN or separate subdomain).
# Comma-separated list of allowed origins.
# Example: https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info            # debug | info | warn | error
